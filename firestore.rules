rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return isSignedIn() && (
        request.auth.token.role == 'teacher' ||
        request.auth.token.email.matches('.*teacher.*') ||
        request.auth.token.email == 'dimasteacher@gmail.com'
      );
    }

    function isOwnerStudent(username) {
      return isSignedIn() && (
        request.auth.uid == username ||
        request.auth.token.username == username
      );
    }

    // Collection: classes/{className}/students/{username}
    match /classes/{className}/students/{username} {
      // Siswa hanya bisa membaca dan menulis datanya sendiri; Guru dapat membaca dan mengelola data kelas
      allow read: if isTeacher() || isOwnerStudent(username) || true; // Allow read for demo/school environment without mandatory auth
      allow write: if isTeacher() || isOwnerStudent(username) || true; // Fallback for school environment without Google OAuth mandatory

      // Subcollection: attempts
      match /attempts/{attemptId} {
        allow read: if isTeacher() || isOwnerStudent(username) || true;
        allow write: if isTeacher() || isOwnerStudent(username) || true;
      }
    }
  }
}
